# Browser-safe Supabase Auth configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Supabase Auth configuration
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Amaal production PostgreSQL (server/worker only)
# This connection points to the Neon production branch. Never expose it to the browser.
AMAAL_DATABASE_URL=
AMAAL_DB_POOL_MAX=10

# Render / Valkey
REDIS_URL=

# OpenAI
OPENAI_API_KEY=

# App security
APP_BASE_URL=
API_BASE_URL=
SESSION_SECRET=

# API runtime
AMAAL_API_AUTOSTART=false
PORT=3000

# Amaal web/API boundary
NEXT_PUBLIC_AMAAL_API_URL=
AMAAL_WEB_ORIGIN=

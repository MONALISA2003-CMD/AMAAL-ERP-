# Browser-safe Amaal application endpoint
NEXT_PUBLIC_AMAAL_API_URL=https://amaal-api.onrender.com

# Server-only Supabase Auth configuration. The browser receives public auth config through /v1/auth/config.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Amaal production PostgreSQL (server/worker only)
# This connection points to the Neon production branch. Never expose it to the browser.
AMAAL_DATABASE_URL=
AMAAL_DB_POOL_MAX=10

# Render / Valkey
REDIS_URL=

# OpenAI
OPENAI_API_KEY=

# App security
APP_BASE_URL=
API_BASE_URL=
SESSION_SECRET=

# API runtime
AMAAL_API_AUTOSTART=false
AMAAL_MFA_ENFORCED=false
PORT=3000

# Amaal web/API boundary
AMAAL_WEB_ORIGIN=https://<your-vercel-origin>

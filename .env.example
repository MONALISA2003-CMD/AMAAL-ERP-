# Browser-safe Amaal application endpoint
NEXT_PUBLIC_AMAAL_API_URL=https://amaal-api.onrender.com

# Neon Auth / Better Auth. These are server-side values except NEXT_PUBLIC_AMAAL_API_URL above.
AMAAL_NEON_AUTH_URL=https://<neon-auth-base-url>
AMAAL_NEON_AUTH_JWKS_URL=https://<neon-auth-base-url>/.well-known/jwks.json
AMAAL_NEON_AUTH_ISSUER=
AMAAL_NEON_AUTH_AUDIENCE=
NEXT_PUBLIC_NEON_AUTH_URL=https://<neon-auth-base-url>

# Amaal production PostgreSQL (server/worker only)
# This connection points to the Neon production branch. Never expose it to the browser.
AMAAL_DATABASE_URL=
AMAAL_DB_POOL_MAX=10

# Render / Valkey
REDIS_URL=

# OpenAI
OPENAI_API_KEY=

# App security
APP_BASE_URL=
API_BASE_URL=
SESSION_SECRET=
AMAAL_MFA_ENCRYPTION_KEY=
AMAAL_MFA_ASSERTION_KEY=

# API runtime
AMAAL_API_AUTOSTART=false
AMAAL_MFA_ENFORCED=false
PORT=3000

# Amaal web/API boundary
AMAAL_WEB_ORIGIN=https://<your-vercel-origin>

# One-time Phase 1 organization setup protection. Keep server-side only; never expose in Vercel.
AMAAL_SETUP_KEY=replace-with-a-long-random-value
NEON_AUTH_COOKIE_SECRET=<set-a-random-secret-at-least-32-characters-on-vercel>

# Stage 6 realtime + role workspaces
AMAAL_VALKEY_URL=
AMAAL_REALTIME_CHANNEL=amaal:realtime
AMAAL_WEB_ORIGIN=
AMAAL_REALTIME_REQUIRE_VALKEY=false
NEXT_PUBLIC_AMAAL_WS_URL=wss://amaal-api.onrender.com

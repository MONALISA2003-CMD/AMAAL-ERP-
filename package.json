{
  "name": "amaal-erp",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm exec turbo run build",
    "check": "pnpm exec turbo run check",
    "lint": "pnpm exec turbo run lint",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "pnpm exec turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "render:api": "node --experimental-transform-types services/api/src/http.ts",
    "render:worker": "node --experimental-transform-types services/outbox-worker/src/runner.ts",
    "validate:repo": "node scripts/validate-repository.mjs",
    "validate:phase0": "node scripts/validate-phase0.mjs",
    "check:phase2a-auth": "node scripts/phase2a-auth-check.mjs",
    "validate:phase2b": "node scripts/validate-phase2b.mjs",
    "validate:phase1": "node scripts/validate-phase1.mjs",
    "validate:phase0-2b": "node scripts/validate-phase0-2b.mjs",
    "validate:phase3": "node scripts/validate-phase3.mjs",
    "validate:phase4": "node scripts/validate-phase4.mjs",
    "test:phase4": "node tests/unit/phase4-rules.test.mjs",
    "validate:phase5": "node scripts/validate-phase5.mjs",
    "validate:phase6": "node scripts/validate-phase6.mjs",
    "test:phase5": "node --experimental-transform-types tests/unit/phase5-aging-recovery.test.mjs",
    "validate:phase7": "node scripts/validate-phase7.mjs",
    "test:phase7": "node --experimental-strip-types tests/unit/phase7-reporting.test.mjs",
    "audit:project": "node scripts/audit-entire-project.mjs",
    "validate:phase8": "node scripts/validate-phase8.mjs",
    "test:phase8": "node --experimental-strip-types tests/unit/phase8-ai-policy.test.mjs && node --experimental-strip-types tests/unit/phase8-ai-redteam.test.mjs && node --experimental-strip-types tests/unit/phase8-output-guardrails.test.mjs",
    "eval:phase8": "node --experimental-strip-types scripts/run-phase8-evals.mjs",
    "validate:phase9": "node scripts/validate-phase9.mjs",
    "test:phase9": "node --experimental-strip-types tests/unit/phase9-intelligence.test.mjs",
    "test:ml": "PYTHONPATH=services/intelligence python3 -m pytest services/intelligence/tests -q",
    "test:all": "node scripts/run-tests.mjs --all",
    "validate:release": "node scripts/validate-release.mjs",
    "verify:deps": "node scripts/verify-dependency-policy.mjs",
    "audit:stage1-9": "node scripts/audit-stage1-9.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "preflight:production": "node scripts/preflight-production.mjs"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "prettier": "3.9.9",
    "turbo": "2.11.4",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "type": "module",
  "dependencies": {},
  "packageManager": "pnpm@12.7.0"
}
